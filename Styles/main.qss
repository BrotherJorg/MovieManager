/* =========================================================
   MOVIEOWL
   CATPPUCCIN-INSPIRED POPCORN WARMTH

   DESIGN SYSTEM

   Page .............. #F6D7A7   warm popcorn
   Sidebar ........... #E8B56A   caramel
   Paper ............. #FFF8E8   warm ivory
   Overlay ........... #F3E5CB   popcorn overlay
   Highlight ......... #FBEFD9   soft hover

   Ink ................ #403545   deep cocoa-plum
   Secondary .......... #75606C   muted mauve

   Caramel ............ #D88932   primary accent
   Caramel Light ...... #E9A957   hover accent
   Rose ............... #B76578   secondary accent
   Teal ............... #2F6F73   information/status
   Gold ............... #B77920   ratings

   DEPTH

     - dark borders
     - bottom borders
     - accent strips
     - layered warm surfaces

   No gradients.
   No random accent colors.
   ========================================================= */


/* =========================================================
   GLOBAL
   ========================================================= */

QWidget {
    background-color: #F6D7A7;
    color: #403545;

    font-family: "Manrope";
    font-size: 16px;
}

QMainWindow {
    background-color: #F6D7A7;
}

QLabel {
    background-color: transparent;
    color: #403545;
}


/* =========================================================
   SIDEBAR
   ========================================================= */

#sidebarWidget {
    background-color: #E8B56A;

    border-right: 3px solid #403545;
}

#sidebarWidget QPushButton {
    background-color: #FFF8E8;
    color: #403545;

    border: 2px solid #403545;
    border-left: 5px solid #B76578;
    border-bottom: 5px solid #403545;
    border-radius: 8px;

    padding: 12px 8px;
    min-height: 20px;

    text-align: left;
    font-size: 13px;
    font-weight: 800;
}

#sidebarWidget QPushButton:hover {
    background-color: #403545;
    color: #FFF8E8;

    border: 2px solid #403545;
    border-left: 5px solid #D88932;
    border-bottom: 5px solid #302936;
}

#sidebarWidget QPushButton:pressed {
    background-color: #302936;
    color: #E9A957;

    border: 2px solid #302936;
    border-left: 5px solid #D88932;
    border-bottom: 2px solid #302936;

    padding: 15px 8px 12px 8px;
}


/* =========================================================
   DASHBOARD
   ========================================================= */

#dashboardView {
    background-color: #F6D7A7;
}

QLabel#dashboardTitle {
    color: #403545;

    font-size: 34px;
    font-weight: 800;

    padding: 14px;

    border-bottom: 4px solid #D88932;
}


/* ---------------------------------------------------------
   DASHBOARD STAT CARDS
   --------------------------------------------------------- */

#dashboardCard {
    background-color: #FFF8E8;

    color: #403545;

    border: 2px solid #403545;
    border-bottom: 5px solid #B76578;
    border-radius: 10px;

    padding: 18px;
}

/* Plain labels inside cards */
#dashboardCard QLabel {
    color: #403545;

    font-weight: 700;
}

#dashboardSection QLabel {
    color: #403545;

    font-size: 14px;
    font-weight: 600;
}

QLabel#dashboardValue {
    color: #2F6F73;

    font-size: 38px;
    font-weight: 800;

    padding: 8px;
}


/* ---------------------------------------------------------
   DASHBOARD SECTIONS
   --------------------------------------------------------- */

#dashboardSection {
    background-color: #FFF8E8;

    border: 2px solid #403545;
    border-left: 6px solid #B76578;
    border-radius: 10px;

    padding: 15px;
}

QLabel#dashboardSectionTitle {
    color: #B76578;

    font-size: 22px;
    font-weight: 800;

    padding-bottom: 6px;

    border-bottom: 3px solid #D88932;
}


/* =========================================================
   MANAGE MOVIES
   ========================================================= */

#manageMoviesTitle {
    color: #403545;

    font-size: 34px;
    font-weight: 800;

    padding: 8px 14px;

    border-bottom: 4px solid #D88932;
}


/* =========================================================
   MOVIE PICKER
   ========================================================= */

#moviePickerView {
    background-color: #F6D7A7;
}

#moviePickerTitle {
    color: #403545;

    font-size: 34px;
    font-weight: 800;

     padding: 2px 14px 8px 14px;

    border-bottom: 4px solid #D88932;
}

#moviePickerDescription {
    color: #75606C;

    font-size: 14px;
    font-weight: 600;

    padding-bottom: 4px;
}


/* ---------------------------------------------------------
   MOVIE RESULT CARD
   --------------------------------------------------------- */

#moviePickerCard {
    background-color: #FFF8E8;

    border: 2px solid #403545;
    border-left: 6px solid #B76578;
    border-bottom: 5px solid #403545;
    border-radius: 10px;

    padding: 25px;
}


/* ---------------------------------------------------------
   POSTER
   --------------------------------------------------------- */

#moviePickerPoster {
    background-color: #F3E5CB;

    border: 2px solid #403545;
    border-radius: 6px;

    color: #75606C;
    font-size: 12px;
}


/* ---------------------------------------------------------
   MOVIE INFORMATION
   --------------------------------------------------------- */

#moviePickerMovieTitle {
    color: #403545;

    font-size: 23px;
    font-weight: 800;
}

#moviePickerDetails {
    color: #75606C;

    font-size: 14px;
    font-weight: 600;
}

#moviePickerRating {
    color: #B77920;

    font-size: 16px;
    font-weight: 800;
}

#moviePickerStatus {
    color: #2F6F73;

    font-size: 13px;
    font-weight: 700;
}


/* ---------------------------------------------------------
   PICK BUTTON
   --------------------------------------------------------- */

#moviePickerButton {
    background-color: #D88932;

    color: #FFF8E8;

    border: 2px solid #403545;
    border-bottom: 5px solid #403545;
    border-radius: 6px;

    padding: 10px 22px;

    font-size: 14px;
    font-weight: 800;
}

#moviePickerButton:hover {
    background-color: #E9A957;

    color: #403545;

    border: 2px solid #403545;
    border-bottom: 5px solid #403545;
}

#moviePickerButton:pressed {
    background-color: #B96F25;

    border: 2px solid #403545;
    border-bottom: 2px solid #403545;
}


/* =========================================================
   RECOMMENDATIONS
   ========================================================= */

#recommendationCard {
    background-color: #FFF8E8;

    border: 2px solid #403545;
    border-left: 6px solid #B76578;
    border-bottom: 5px solid #403545;
    border-radius: 10px;

    padding: 12px;
}

#recommendationCard:hover {
    background-color: #FBEFD9;

    border-left: 6px solid #D88932;
}

#recommendationTitle {
    color: #403545;

    font-size: 17px;
    font-weight: 800;
}

#recommendationDetails {
    color: #75606C;

    font-weight: 600;
}

#recommendationRating {
    color: #B77920;

    font-weight: 800;
}

#recommendationReason {
    color: #2F6F73;

    font-weight: 600;

    padding-top: 5px;
}

#recommendationPageTitle {
    color: #403545;

    font-size: 34px;
    font-weight: 800;

    padding: 8px 14px;

    border-bottom: 4px solid #D88932;
}

#recommendationPageDescription {
    color: #75606C;

    font-size: 14px;
    font-weight: 600;
}


/* =========================================================
   GENERAL BUTTONS
   ========================================================= */

QPushButton {
    background-color: #D88932;

    color: #FFF8E8;

    border: 2px solid #403545;
    border-bottom: 4px solid #403545;
    border-radius: 6px;

    padding: 8px 14px;

    font-weight: 800;
}

QPushButton:hover {
    background-color: #E9A957;

    color: #403545;

    border: 2px solid #403545;
    border-bottom: 4px solid #403545;
}

QPushButton:pressed {
    background-color: #B96F25;

    border: 2px solid #403545;
    border-bottom: 2px solid #403545;
}

QPushButton:disabled {
    background-color: #E8D5B8;

    color: #9A8C91;

    border: 2px solid #C7B9AE;
}


/* =========================================================
   INPUTS
   ========================================================= */

QLineEdit,
QComboBox {
    background-color: #FFF8E8;

    color: #403545;

    border: 2px solid #403545;
    border-radius: 6px;

    padding: 9px 10px;
}

QLineEdit:hover,
QComboBox:hover {
    border: 2px solid #B76578;
}

QLineEdit:focus,
QComboBox:focus {
    background-color: #FFFFFF;

    border: 2px solid #2F6F73;
}


/* ---------------------------------------------------------
   COMBO BOX DROPDOWN
   --------------------------------------------------------- */

QComboBox::drop-down {
    border: none;

    width: 25px;
}

QComboBox QAbstractItemView {
    background-color: #FFF8E8;

    color: #403545;

    border: 2px solid #403545;

    selection-background-color: #403545;
    selection-color: #FFF8E8;
}


/* =========================================================
   TABLE
   ========================================================= */

QTableWidget {
    background-color: #FFF8E8;

    alternate-background-color: #F3E5CB;

    color: #403545;

    border: 2px solid #403545;
    gridline-color: #DDCCB7;

    selection-background-color: #403545;
    selection-color: #FFF8E8;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:selected {
    background-color: #403545;

    color: #FFF8E8;
}

QHeaderView::section {
    background-color: #403545;

    color: #FFF8E8;

    border: none;
    border-bottom: 3px solid #D88932;

    padding: 8px;

    font-weight: 800;
}

QHeaderView::section:hover {
    background-color: #554656;

    color: #E9A957;
}


/* =========================================================
   SCROLLBARS
   ========================================================= */

QScrollBar:vertical {
    background-color: #E8B56A;

    width: 10px;

    border: none;
}

QScrollBar::handle:vertical {
    background-color: #75606C;

    min-height: 30px;

    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #403545;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;

    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}


/* ---------------------------------------------------------
   HORIZONTAL SCROLLBAR
   --------------------------------------------------------- */

QScrollBar:horizontal {
    background-color: #E8B56A;

    height: 10px;

    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #75606C;

    min-width: 30px;

    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #403545;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;

    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
}


/* =========================================================
   DIALOGS
   ========================================================= */

QDialog {
    background-color: #F3E5CB;

    color: #403545;
}

QDialog QLabel {
    color: #403545;
}

QDialog QLineEdit,
QDialog QComboBox,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QTextEdit {
    background-color: #FFF8E8;

    color: #403545;

    border: 2px solid #403545;
    border-radius: 6px;

    padding: 8px;
}

QDialog QLineEdit:hover,
QDialog QComboBox:hover,
QDialog QSpinBox:hover,
QDialog QDoubleSpinBox:hover,
QDialog QTextEdit:hover {
    border: 2px solid #B76578;
}

QDialog QLineEdit:focus,
QDialog QComboBox:focus,
QDialog QSpinBox:focus,
QDialog QDoubleSpinBox:focus,
QDialog QTextEdit:focus {
    background-color: #FFFFFF;

    border: 2px solid #2F6F73;
}

QDialog QPushButton {
    background-color: #D88932;

    color: #FFF8E8;

    border: 2px solid #403545;
    border-bottom: 4px solid #403545;
    border-radius: 6px;

    padding: 8px 16px;
}

QDialog QPushButton:hover {
    background-color: #E9A957;

    color: #403545;

    border: 2px solid #403545;
    border-bottom: 4px solid #403545;
}

QDialog QPushButton:pressed {
    background-color: #B96F25;

    border: 2px solid #403545;
    border-bottom: 2px solid #403545;
}


/* =========================================================
   MESSAGE BOXES
   ========================================================= */

QMessageBox {
    background-color: #F3E5CB;

    color: #403545;
}

QMessageBox QLabel {
    color: #403545;
}

QMessageBox QPushButton {
    min-width: 75px;
}


/* =========================================================
   TOOLTIP
   ========================================================= */

QToolTip {
    background-color: #403545;

    color: #FFF8E8;

    border: 2px solid #D88932;

    padding: 6px;
}


/* =========================================================
   COLLECTIONS
   ========================================================= */

#collectionsView {
    background-color: #F6D7A7;
}


/* ---------------------------------------------------------
   COLLECTIONS TITLE
   --------------------------------------------------------- */

QLabel#collectionsTitle {
    color: #403545;

    font-size: 34px;
    font-weight: 800;

    padding: 8px 14px;

    border-bottom: 4px solid #D88932;
}


/* ---------------------------------------------------------
   COLLECTION LIST
   --------------------------------------------------------- */

#collectionList {
    background-color: #FFF8E8;

    color: #403545;

    border: 2px solid #403545;
    border-left: 6px solid #B76578;
    border-radius: 10px;

    padding: 6px;
}

#collectionList::item {
    background-color: #FFF8E8;

    color: #403545;

    padding: 10px;

    border-bottom: 1px solid #DDCCB7;
}

#collectionList::item:hover {
    background-color: #FBEFD9;

    color: #403545;
}

#collectionList::item:selected {
    background-color: #403545;

    color: #FFF8E8;
}


/* ---------------------------------------------------------
   CURRENT COLLECTION TITLE
   --------------------------------------------------------- */

QLabel#collectionTitle {
    color: #B76578;

    font-size: 22px;
    font-weight: 800;

    padding: 8px;

    border-bottom: 3px solid #D88932;
}


/* ---------------------------------------------------------
   COLLECTION MOVIE LIST
   --------------------------------------------------------- */

#collectionMovieList {
    background-color: #FFF8E8;

    color: #403545;

    border: 2px solid #403545;
    border-left: 6px solid #2F6F73;
    border-radius: 10px;

    padding: 6px;
}

#collectionMovieList::item {
    background-color: #FFF8E8;

    color: #403545;

    padding: 10px;

    border-bottom: 1px solid #DDCCB7;
}

#collectionMovieList::item:hover {
    background-color: #FBEFD9;

    color: #403545;
}

#collectionMovieList::item:selected {
    background-color: #403545;

    color: #FFF8E8;
}


/* ---------------------------------------------------------
   COLLECTION BUTTONS
   --------------------------------------------------------- */

#collectionsCreateButton {
    background-color: #D88932;

    color: #FFF8E8;

    border: 2px solid #403545;
    border-bottom: 4px solid #403545;
    border-radius: 6px;

    padding: 8px 14px;

    font-weight: 800;
}

#collectionsCreateButton:hover {
    background-color: #E9A957;

    color: #403545;

    border: 2px solid #403545;
    border-bottom: 4px solid #403545;
}

#collectionsCreateButton:pressed {
    background-color: #B96F25;

    border: 2px solid #403545;
    border-bottom: 2px solid #403545;
}


#collectionsDeleteButton {
    background-color: #B76578;

    color: #FFF8E8;

    border: 2px solid #403545;
    border-bottom: 4px solid #403545;
    border-radius: 6px;

    padding: 8px 14px;

    font-weight: 800;
}

#collectionsDeleteButton:hover {
    background-color: #D88932;

    color: #FFF8E8;

    border: 2px solid #403545;
    border-bottom: 4px solid #403545;
}

#collectionsDeleteButton:pressed {
    background-color: #965466;

    border: 2px solid #403545;
    border-bottom: 2px solid #403545;
}


/* ---------------------------------------------------------
   COLLECTION MOVIE CONTROLS
   --------------------------------------------------------- */

#collectionsView #addMovieButton,
#collectionsView #removeMovieButton {
    background-color: #D88932;

    color: #FFF8E8;

    border: 2px solid #403545;
    border-bottom: 4px solid #403545;
    border-radius: 6px;

    padding: 8px 14px;

    font-weight: 800;
}

#collectionsView #addMovieButton:hover,
#collectionsView #removeMovieButton:hover {
    background-color: #E9A957;

    color: #403545;

    border: 2px solid #403545;
    border-bottom: 4px solid #403545;
}

#collectionsView #addMovieButton:pressed,
#collectionsView #removeMovieButton:pressed {
    background-color: #B96F25;

    border: 2px solid #403545;
    border-bottom: 2px solid #403545;
}

