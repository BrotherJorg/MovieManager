/* =========================================================
   MOVIEOWL
   PASTEL ORANGE BASE + BROWN BORDERS + METALLIC ACCENTS

   Background (from your image) ... #fac898
   Panel light ..................... #fcd9b6   (cards, sections)
   Input light ..................... #fde7cf
   Sidebar ......................... #f0b27f
   Brown border (weight) ........... #7a4a2a
   Dark brown text ................. #3b2314
   Secondary text .................. #6b4630
   Copper (buttons / headers) ...... #b87333
   Bronze (pressed) ................ #8c5a2b
   Burnt copper (big titles) ....... #8a3f12
   Dark gold (values, ratings) ..... #7d5a00
   Deep teal (complement, status) .. #1f6f5f
   ========================================================= */


/* =========================================================
   GLOBAL
   ========================================================= */

QWidget {
    background-color: #fac898;
    color: #3b2314;

    font-family: "Manrope";
    font-size: 14px;
}

QMainWindow {
    background-color: #fac898;
}

QLabel {
    background-color: transparent;
    color: #3b2314;
}


/* =========================================================
   SIDEBAR
   ========================================================= */

#sidebarWidget {
    background-color: #f0b27f;

    border-right: 2px solid #7a4a2a;
}

#sidebarWidget QPushButton {
    background-color: transparent;
    color: #3b2314;

    border: none;
    border-left: 3px solid transparent;
    border-radius: 5px;

    padding: 11px 13px;
    text-align: left;
}

#sidebarWidget QPushButton:hover {
    background-color: #b87333;
    color: #fff4e6;

    border-left: 3px solid #7a4a2a;
}

#sidebarWidget QPushButton:pressed {
    background-color: #8c5a2b;
    color: #fff4e6;

    border-left: 3px solid #3b2314;
}


/* =========================================================
   DASHBOARD
   ========================================================= */

#dashboardView {
    background-color: #fac898;
}

QLabel#dashboardTitle {
    color: #8a3f12;

    font-size: 30px;
    font-weight: 700;

    padding: 10px;
}


/* ---------------------------------------------------------
   DASHBOARD STAT CARDS
   --------------------------------------------------------- */

#dashboardCard {
    background-color: #fcd9b6;

    color: #3b2314;

    border: 2px solid #7a4a2a;
    border-radius: 8px;

    padding: 14px;
}

QLabel#dashboardValue {
    color: #7d5a00;

    font-size: 30px;
    font-weight: 700;

    padding: 8px;
}


/* ---------------------------------------------------------
   DASHBOARD SECTIONS
   --------------------------------------------------------- */

#dashboardSection {
    background-color: #fcd9b6;

    border: 2px solid #7a4a2a;
    border-radius: 8px;

    padding: 15px;
}

QLabel#dashboardSectionTitle {
    color: #8a3f12;

    font-size: 18px;
    font-weight: 700;

    padding-bottom: 9px;

    border-bottom: 2px solid #b87333;
}


/* =========================================================
   MOVIE PICKER
   ========================================================= */

#moviePickerView {
    background-color: #fac898;
}

#moviePickerTitle {
    color: #8a3f12;

    font-size: 28px;
    font-weight: 700;
}

#moviePickerDescription {
    color: #6b4630;

    font-size: 14px;
}


/* ---------------------------------------------------------
   MOVIE RESULT CARD
   --------------------------------------------------------- */

#moviePickerCard {
    background-color: #fcd9b6;

    border: 2px solid #7a4a2a;
    border-left: 5px solid #b87333;
    border-radius: 8px;

    padding: 15px;
}


/* ---------------------------------------------------------
   POSTER
   --------------------------------------------------------- */

#moviePickerPoster {
    background-color: #fde7cf;

    border: 2px solid #7a4a2a;
    border-radius: 6px;

    color: #6b4630;
    font-size: 12px;
}


/* ---------------------------------------------------------
   MOVIE INFORMATION
   --------------------------------------------------------- */

#moviePickerMovieTitle {
    color: #3b2314;

    font-size: 21px;
    font-weight: 700;
}

#moviePickerDetails {
    color: #6b4630;

    font-size: 14px;
}

#moviePickerRating {
    color: #7d5a00;

    font-size: 16px;
    font-weight: 700;
}

#moviePickerStatus {
    color: #1f6f5f;

    font-size: 13px;
}


/* ---------------------------------------------------------
   PICK BUTTON
   --------------------------------------------------------- */

#moviePickerButton {
    background-color: #b87333;

    color: #fff4e6;

    border: 2px solid #7a4a2a;
    border-radius: 6px;

    padding: 10px 22px;

    font-size: 14px;
    font-weight: 600;
}

#moviePickerButton:hover {
    background-color: #c98a4b;

    color: #fff4e6;

    border: 2px solid #3b2314;
}

#moviePickerButton:pressed {
    background-color: #8c5a2b;

    border: 2px solid #3b2314;
}


/* =========================================================
   RECOMMENDATIONS
   ========================================================= */

#recommendationCard {
    background-color: #fcd9b6;

    border: 2px solid #7a4a2a;
    border-left: 5px solid #b87333;
    border-radius: 7px;

    padding: 12px;
}

#recommendationCard:hover {
    background-color: #fde7cf;

    border-left: 5px solid #8a3f12;
}

#recommendationTitle {
    color: #3b2314;

    font-size: 17px;
    font-weight: 700;
}

#recommendationDetails {
    color: #6b4630;
}

#recommendationRating {
    color: #7d5a00;

    font-weight: 700;
}

#recommendationReason {
    color: #1f6f5f;

    padding-top: 5px;
}

#recommendationPageTitle {
    color: #8a3f12;

    font-size: 28px;
    font-weight: 700;
}

#recommendationPageDescription {
    color: #6b4630;

    font-size: 14px;
}


/* =========================================================
   GENERAL BUTTONS
   ========================================================= */

QPushButton {
    background-color: #b87333;

    color: #fff4e6;

    border: 2px solid #7a4a2a;
    border-radius: 6px;

    padding: 8px 14px;
}

QPushButton:hover {
    background-color: #c98a4b;

    color: #fff4e6;

    border: 2px solid #3b2314;
}

QPushButton:pressed {
    background-color: #8c5a2b;

    border: 2px solid #3b2314;
}

QPushButton:disabled {
    background-color: #e9b98c;

    color: #9a7455;

    border: 2px solid #c99a70;
}


/* =========================================================
   INPUTS
   ========================================================= */

QLineEdit,
QComboBox {
    background-color: #fde7cf;

    color: #3b2314;

    border: 2px solid #7a4a2a;
    border-radius: 6px;

    padding: 8px;
}

QLineEdit:hover,
QComboBox:hover {
    border: 2px solid #b87333;
}

QLineEdit:focus,
QComboBox:focus {
    background-color: #fff4e6;

    border: 2px solid #8a3f12;
}


/* ---------------------------------------------------------
   COMBO BOX DROPDOWN
   --------------------------------------------------------- */

QComboBox::drop-down {
    border: none;

    width: 25px;
}

QComboBox QAbstractItemView {
    background-color: #fde7cf;

    color: #3b2314;

    border: 2px solid #7a4a2a;

    selection-background-color: #b87333;
    selection-color: #fff4e6;
}


/* =========================================================
   TABLE
   ========================================================= */

QTableWidget {
    background-color: #fde7cf;

    alternate-background-color: #fcd9b6;

    color: #3b2314;

    border: 2px solid #7a4a2a;
    gridline-color: #d9a272;

    selection-background-color: #c98a4b;
    selection-color: #2b160a;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:selected {
    background-color: #c98a4b;

    color: #2b160a;
}

QHeaderView::section {
    background-color: #b87333;

    color: #fff4e6;

    border: none;
    border-bottom: 2px solid #7a4a2a;

    padding: 8px;

    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: #c98a4b;

    color: #fff4e6;
}


/* =========================================================
   DIALOGS
   ========================================================= */

QDialog {
    background-color: #fbd2a6;

    color: #3b2314;
}

QDialog QLabel {
    color: #3b2314;
}

QDialog QLineEdit,
QDialog QComboBox,
QDialog QSpinBox,
QDialog QDoubleSpinBox,
QDialog QTextEdit {
    background-color: #fde7cf;

    color: #3b2314;

    border: 2px solid #7a4a2a;
    border-radius: 6px;

    padding: 8px;
}

QDialog QLineEdit:hover,
QDialog QComboBox:hover,
QDialog QSpinBox:hover,
QDialog QDoubleSpinBox:hover,
QDialog QTextEdit:hover {
    border: 2px solid #b87333;
}

QDialog QLineEdit:focus,
QDialog QComboBox:focus,
QDialog QSpinBox:focus,
QDialog QDoubleSpinBox:focus,
QDialog QTextEdit:focus {
    background-color: #fff4e6;

    border: 2px solid #8a3f12;
}

QDialog QPushButton {
    background-color: #b87333;

    color: #fff4e6;

    border: 2px solid #7a4a2a;
    border-radius: 6px;

    padding: 8px 16px;
}

QDialog QPushButton:hover {
    background-color: #c98a4b;

    color: #fff4e6;

    border: 2px solid #3b2314;
}

QDialog QPushButton:pressed {
    background-color: #8c5a2b;

    border: 2px solid #3b2314;
}


/* =========================================================
   MESSAGE BOXES
   ========================================================= */

QMessageBox {
    background-color: #fbd2a6;

    color: #3b2314;
}

QMessageBox QLabel {
    color: #3b2314;
}

QMessageBox QPushButton {
    min-width: 75px;
}


/* =========================================================
   SCROLLBARS
   ========================================================= */

QScrollBar:vertical {
    background: #f0b27f;

    width: 9px;

    border: none;
}

QScrollBar::handle:vertical {
    background: #a86a3a;

    min-height: 30px;

    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #7a4a2a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #f0b27f;

    height: 9px;

    border: none;
}

QScrollBar::handle:horizontal {
    background: #a86a3a;

    min-width: 30px;

    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #7a4a2a;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}


/* =========================================================
   TOOLTIP
   ========================================================= */

QToolTip {
    background-color: #3b2314;

    color: #fde7cf;

    border: 2px solid #b87333;

    padding: 6px;
}
